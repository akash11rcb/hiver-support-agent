# Copy this file to .env and fill in your key.
# Free key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Model used for classification / drafting / judging. gemini-3.6-flash for
# all three is the default (fast, cheap, comfortably inside the free tier).
# Check https://ai.google.dev/gemini-api/docs/models for current model IDs --
# these are examples, not guaranteed to be current.
CLASSIFIER_MODEL=gemini-3.6-flash
DRAFTER_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.6-flash

BRAND_HANDLE=Uber_Support
