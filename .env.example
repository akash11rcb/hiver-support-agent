# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for classification / drafting / judging (split so you can use a
# cheap/fast model for high-volume classification and a stronger one for
# drafting + judging). Check https://docs.claude.com/en/docs/about-claude/models
# for the current model IDs available to your API key -- these are examples.
CLASSIFIER_MODEL=claude-haiku-4-5
DRAFTER_MODEL=claude-sonnet-4-5
JUDGE_MODEL=claude-sonnet-4-5
